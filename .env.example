# ---- Brain -----------------------------------------------------------------
# auto  : use 'api' if any key below is set, otherwise 'offline' (no key needed)
# offline: deterministic playbook executor + statistical learner (free, no network)
# api   : free LLM via OpenAI-compatible API (Gemini -> OpenRouter -> NVIDIA fallback chain)
# hermes: Hermes Agent drives decisions + skill edits through the MCP server (run `revenue-agent hermes-setup` first)
ENGINE=auto

# ---- Free LLM keys (any one is enough; never commit real keys) ---------------
GEMINI_API_KEY=            # https://aistudio.google.com/apikey  (free tier, no card)
OPENROUTER_API_KEY=        # https://openrouter.ai/keys          (free ':free' models)
NVIDIA_API_KEY=            # https://build.nvidia.com            (free credits)
LLM_PROVIDERS=gemini,openrouter,nvidia
# GEMINI_MODEL=gemini-3.5-flash,gemini-flash-latest   # default: tried in order
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ---- Cost + rate limits (hard caps, fail closed) ----------------------------
RUN_LLM_CALL_CAP=40
DAILY_LLM_CALL_CAP=300
RUN_TOKEN_CAP=600000
LLM_TIMEOUT_S=90
LLM_MAX_RETRIES=3

# ---- Business policy ----------------------------------------------------------
APPROVAL_THRESHOLD_CENTS=10000000  # >= 100,000 EGP (in piastres) needs a human
MAX_TOUCHES=3
MAX_INSTALLMENTS=3

# ---- Learning -------------------------------------------------------------------
EXPLORE_RATE=0.35
TRAIN_SIZE=60
EVAL_SIZE=40
EVAL_SEEDS=101
PROMOTION_MARGIN=0.05

# ---- Hermes ---------------------------------------------------------------------
# REQUIRED for ENGINE=hermes (it refuses to run without it, so a paid default model is never used by accident)
HERMES_PROFILE=tahseel           # isolated Hermes profile created by `revenue-agent hermes-setup`
HERMES_MODEL=gemini-flash-latest
HERMES_PROVIDER=gemini
HERMES_TIMEOUT_S=300
HERMES_SKILL_SYNC=1

# ---- Ribhiya app ---------------------------------------------------------------
ADMIN_TOKEN=                     # set on any shared/public deployment: every state-changing API call needs it

# ---- Real email sending (off by default; without it Tahsila only drafts + copies) --
EMAIL_SENDING_ENABLED=0
SMTP_HOST=
SMTP_PORT=587                    # 465 = implicit TLS; otherwise STARTTLS
SMTP_STARTTLS=1
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=                       # e.g. accounts@yourbusiness.com

# ---- MCP server (external agent platforms) ---------------------------------------
MCP_TRANSPORT=stdio              # stdio | streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8811

# ---- Access control (enforced on every /api request once any token is set) ---------
# ADMIN_TOKEN=...                      # admin of tenant "default" (simulation lab, kill switch, all data)
# TENANT_TOKENS=acme:tok-acme-xxxxxxxx,beta:tok-beta-xxxxxxxx   # members, confined to their tenant (token ≥12 chars)
# MCP_TENANT=default                   # the one tenant an MCP server process may read

# ---- Interactive agent budgets (per user request / per chat session) ---------------
MAX_MODEL_CALLS_PER_REQUEST=6
MAX_AGENT_STEPS=5
MAX_TOOL_CALLS_PER_REQUEST=10
MAX_INPUT_TOKENS=24000                 # estimated prompt size ceiling (≈3 chars/token)
MAX_OUTPUT_TOKENS=2000
MAX_REQUEST_SECONDS=75
MAX_USER_MESSAGE_CHARS=2000            # longer messages are rejected (HTTP 413), not silently cut
MAX_HISTORY_MESSAGES=6
MAX_SESSION_TOKENS=200000
LLM_PRICE_IN_PER_1K=0                  # USD; 0 = unknown -> cost is not estimated (never invented)
LLM_PRICE_OUT_PER_1K=0
MAX_COST_PER_REQUEST_USD=0             # 0 = off; only meaningful when prices above are set

# ---- Profit investigation advisor --------------------------------------------------
PROFIT_ADVISOR_ENGINE=auto             # auto | hermes | api | rules (hermes needs `revenue-agent hermes-setup-profit`)
GUIDE_ENGINE=auto                      # in-app guide: auto | api | rules. The AI only sees the question + help text, never your data
# TAHSEELA_HERMES_PROFILE=tahseela     # locked-down Hermes profile name (per tenant: tahseela-<tenant>)
