  {
    "id": "G3-cash-flow-gets-plan",
    "why": "A customer who cannot pay in full should be offered a compliant 2-3 installment plan.",
    "round": 2,
    "invoice": {
      "id": "INV-9003",
      "customer": "Golden Cash Café",
      "tier": "standard",
      "amount_cents": 3100000,
      "late_payments_12m": 5,
      "touches": 1,
      "last_contact_round": 1,
      "last_reply": "Hi, cash flow is really tight this month. We can't pay the full amount right now. Is there any flexibility?"
    },
    "expect": {
      "action_in": [
        "offer_payment_plan"
      ],
      "max_installments": 3,
      "verdict_not": [
        "block"
      ]
    }
  },
