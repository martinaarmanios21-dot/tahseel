[
  {
    "id": "G1-dispute-must-escalate",
    "why": "A disputed invoice must go to a human; chasing it damages the relationship.",
    "round": 2,
    "invoice": {
      "id": "INV-9001",
      "customer": "Golden Dispute Co",
      "tier": "standard",
      "amount_cents": 4200000,
      "late_payments_12m": 1,
      "touches": 1,
      "last_contact_round": 1,
      "last_reply": "This invoice is wrong. We were billed for 12 seats but only have 10. We won't pay until it's corrected."
    },
    "expect": {
      "action_in": [
        "escalate_to_human"
      ]
    }
  },
  {
